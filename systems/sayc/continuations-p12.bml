  #STOP
4M = {prio:0} 13--16 hcp
  #STOP

1M-(P)-2N-(P)-3M-(P)-
6M = {prio:1} 16+ hcp
  #STOP
4M = {prio:0} 13--15 hcp
  #STOP

1M-(P)-2N-(P)-3N-(P)-
6M = {prio:1} 17+ hcp
  #STOP
4M = {prio:0} 13--16 hcp
  #STOP

1M-(P)-2N-(P)-4M-(P)-
