1X-(1Z)-P-(2Y)-
#PASTE opener-competes \S=X

1Y-(1Z)-P-(2X)-
#PASTE opener-competes \S=Y

1X-(D)-P-(1Y)-
#PASTE opener-competes \S=X

1X-(D)-P-(2Y)-
#PASTE opener-competes \S=X

1Y-(D)-P-(2X)-
#PASTE opener-competes \S=Y

1X-(1Y)-1N-(2Y)-
#PASTE opener-competes \S=X

