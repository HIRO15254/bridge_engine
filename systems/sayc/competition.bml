1H = {prio:6} 0--11 hcp, 4+!h or 0--8 hcp and 3+!h and 0--2!d and 0--3!s
1S = {prio:5} 0--11 hcp, 4+!s or 0--8 hcp and 3+!s and 0--2!d and 0--2!h
1D = {prio:4} 0--11 hcp, 4+!d or 0--8 hcp and 3+!d and 0--3!h and 0--3!s
#ENDCOPY

