2H-
2N = {prio:-2} F
  3H = 5--8 hcp
  3C = {prio:3} 9--11 hcp
  3D = {prio:2} 9--11 hcp
  3S = {prio:1} 9--11 hcp
  3N = {prio:0} 9--11 hcp
2S = F, 10+ hcp, 5+!s
3C = F, 10+ hcp, 5+!c
3D = F, 10+ hcp, 5+!d
3N = {prio:-1} unlimited
4H = unlimited

