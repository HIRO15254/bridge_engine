  3S = 5--8 hcp
  3C = {prio:3} 9--11 hcp
  3D = {prio:2} 9--11 hcp
  3H = {prio:1} 9--11 hcp
  3N = {prio:0} 9--11 hcp
3C = F, 10+ hcp, 5+!c
3D = F, 10+ hcp, 5+!d
3H = F, 10+ hcp, 5+!h
3N = {prio:-1} unlimited
